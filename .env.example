# Supabase (URL + anon key เปิดเผยได้ — คุมด้วย RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 (S3-compatible) — server only ทั้งหมด
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=auto-design
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://your-public-bucket-url.r2.dev
TOKEN_VALUE=your-cloudflare-api-token
# ค่าเริ่มต้นเรตเงิน (override ได้ในหน้า admin settings)
DEFAULT_USD_TO_THB=36

# Admin bootstrap — server only
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
